#cloud-config

output:
  all: ">> /var/log/cloud-init-output.log"

ssh_quiet_keygen: true

autoinstall:
  version: 1

  locale: en_US.UTF-8

  keyboard:
    layout: us

  identity:
    hostname: {{ machine_name }}
    username: {{ username }}
    password: "{{ password_hash }}"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "{{ ssh_authorized_key }}"

  storage:
    config:
      - id: disk-os
        type: disk
        match:
          serial: "{{ os_disk_serial }}"
        wipe: superblock-recursive
        preserve: false
        ptable: gpt

      - id: partition-efi
        type: partition
        device: disk-os
        size: 1G
        flag: boot
        grub_device: true
        number: 1

      - id: format-efi
        type: format
        volume: partition-efi
        fstype: fat32

      - id: mount-efi
        type: mount
        device: format-efi
        path: /boot/efi

      - id: partition-root
        type: partition
        device: disk-os
        size: -1
        number: 2

      - id: format-root
        type: format
        volume: partition-root
        fstype: ext4

      - id: mount-root
        type: mount
        device: format-root
        path: /

  packages:
    - openssh-server

  updates: security

  late-commands:
    - curtin in-target --target=/target -- systemctl enable ssh.service

    - mkdir -p /target/etc/ai-forge

    - |
      cat > /target/etc/ai-forge/machine.json <<'EOF'
      {
        "machine_id": "{{ machine_name }}",
        "provisioning_mac": "{{ provisioning_mac }}"
      }
      EOF

    - chown root:root /target/etc/ai-forge/machine.json
    - chmod 0644 /target/etc/ai-forge/machine.json

    - |
      echo '{{ boot_control_b64 }}' | base64 -d > /target/usr/local/sbin/ai-forge-boot-control

    - chown root:root /target/usr/local/sbin/ai-forge-boot-control
    - chmod 0755 /target/usr/local/sbin/ai-forge-boot-control

    - |
      cat > /target/etc/sudoers.d/ai-forge-boot-control <<'EOF'
      {{ username }} ALL=(root) NOPASSWD: /usr/local/sbin/ai-forge-boot-control status
      {{ username }} ALL=(root) NOPASSWD: /usr/local/sbin/ai-forge-boot-control pxe-next
      {{ username }} ALL=(root) NOPASSWD: /usr/local/sbin/ai-forge-boot-control clear-next
      {{ username }} ALL=(root) NOPASSWD: /usr/local/sbin/ai-forge-boot-control reboot
      {{ username }} ALL=(root) NOPASSWD: /usr/local/sbin/ai-forge-boot-control poweroff
      EOF

    - chown root:root /target/etc/sudoers.d/ai-forge-boot-control
    - chmod 0440 /target/etc/sudoers.d/ai-forge-boot-control

    - curtin in-target --target=/target -- visudo -cf /etc/sudoers.d/ai-forge-boot-control

    # AI Forge unattended Ansible management identity
    - curtin in-target --target=/target -- useradd --create-home --shell /bin/bash --comment "AI Forge automation" ai-forge

    - curtin in-target --target=/target -- passwd -l ai-forge

    - mkdir -p /target/home/ai-forge/.ssh

    - |
      cat > /target/home/ai-forge/.ssh/authorized_keys <<'EOF'
      {{ ssh_authorized_key }}
      EOF

    - curtin in-target --target=/target -- chown -R ai-forge:ai-forge /home/ai-forge/.ssh
    - chmod 0700 /target/home/ai-forge/.ssh
    - chmod 0600 /target/home/ai-forge/.ssh/authorized_keys

    - |
      cat > /target/etc/sudoers.d/90-ai-forge-ansible <<'EOF'
      ai-forge ALL=(ALL) NOPASSWD: ALL
      EOF

    - chown root:root /target/etc/sudoers.d/90-ai-forge-ansible
    - chmod 0440 /target/etc/sudoers.d/90-ai-forge-ansible

    - curtin in-target --target=/target -- visudo -cf /etc/sudoers.d/90-ai-forge-ansible

    - |
      cat > /target/etc/cloud/cloud.cfg.d/99-ai-forge-console.cfg <<'EOF'
      output:
        all: ">> /var/log/cloud-init-output.log"
      ssh_quiet_keygen: true
      EOF

    - chown root:root /target/etc/cloud/cloud.cfg.d/99-ai-forge-console.cfg
    - chmod 0644 /target/etc/cloud/cloud.cfg.d/99-ai-forge-console.cfg
