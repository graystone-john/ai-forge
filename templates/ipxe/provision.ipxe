#!ipxe

set server {{ provisioning_server }}
set boot_base {{ ubuntu_boot_base_url }}
set iso {{ ubuntu_iso }}
set iso_url {{ ubuntu_iso_url }}

echo ==================================================
echo Graystone AI Forge
echo Machine: {{ machine_name }}
echo Mode: PROVISION
echo Ubuntu {{ ubuntu_version }} Server
echo ==================================================
echo
echo WARNING: Automated installation is starting.
echo The configured OS disk will be erased.
echo
echo Loading Ubuntu kernel...

set semi:hex 3b

kernel ${boot_base}/vmlinuz initrd=initrd ip=dhcp url=${iso_url} autoinstall ds=nocloud-net${semi:string}s=http://${server}/pxe/{{ machine_name }}/ nomodeset

echo Loading Ubuntu initrd...
initrd --name initrd ${boot_base}/initrd

echo Starting Ubuntu Autoinstall...
boot
