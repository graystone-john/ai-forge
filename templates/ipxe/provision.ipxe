#!ipxe

set server {{ provisioning_server }}
set base http://${server}/pxe/ubuntu/{{ ubuntu_version }}
set iso {{ ubuntu_iso }}

echo ==================================================
echo Graystone AI Forge
echo Machine: {{ machine_name }}
echo Mode: PROVISION
echo Ubuntu {{ ubuntu_version }} Server
echo ==================================================
echo
echo WARNING: Automated installation is starting.
echo The configured OS disk will be erased.
echo
echo Loading Ubuntu kernel...

set semi:hex 3b

kernel ${base}/vmlinuz initrd=initrd ip=dhcp url=${base}/${iso} autoinstall ds=nocloud-net${semi:string}s=http://${server}/pxe/{{ machine_name }}/ nomodeset

echo Loading Ubuntu initrd...
initrd --name initrd ${base}/initrd

echo Starting Ubuntu Autoinstall...
boot
