#!ipxe

set server 10.10.10.1
set base http://${server}/pxe/ubuntu/24.04
set iso ubuntu-24.04.4-live-server-amd64.iso

echo ==================================================
echo Graystone AI Forge
echo Machine: Daedalus
echo Ubuntu 24.04.4 LTS Server
echo ==================================================
echo
echo Loading Ubuntu kernel...

kernel ${base}/vmlinuz \
  ip=dhcp \
  url=${base}/${iso} \
  cloud-config-url=/dev/null

echo Loading Ubuntu initrd...
initrd ${base}/initrd

echo Starting Ubuntu installer...
boot
