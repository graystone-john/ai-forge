# Copy to machines/<machine-name>/machine.yaml.example.
# Replace all placeholders before activating as machine.yaml.
# Numeric fields must become YAML integers; profiles must become a list.
# Hardware identifiers must describe the target machine.

name: daedalus-01
family: daedalus
generation: 1

role: MACHINE_ROLE
architecture: MACHINE_ARCHITECTURE

hardware:
  motherboard: MACHINE_MOTHERBOARD
  cpu: MACHINE_CPU
  memory_gb: MACHINE_MEMORY_GB
  gpu: MACHINE_GPU

  os_disk:
    model: OS_DISK_MODEL
    serial: OS_DISK_SERIAL
    # Verify through the intended internal interface.
    # Do not substitute a USB enclosure identifier.
    udev_serial: OS_DISK_UDEV_SERIAL

network:
  provisioning_mac: "PROVISIONING_MAC"
  provisioning_ip: PROVISIONING_IP
  provisioning_subnet: PROVISIONING_SUBNET
  provisioning_interface: PROVISIONING_INTERFACE
  wifi_interface: WIFI_INTERFACE

ansible:
  user: ai-forge

# Replace with a YAML list of existing profile names.
inference_profile: INFERENCE_PROFILE
runtime_profile: RUNTIME_PROFILE

profiles: MACHINE_PROFILES
