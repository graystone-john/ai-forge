#!/usr/bin/env bash
set -euo pipefail

AGENT_USER="{{ agent_identity.user }}"
WORKSPACE="/home/{{ agent_identity.user }}/graystone/ai-forge"

if [[ ! -d "$WORKSPACE/.git" ]]; then
    echo "ERROR: Agent workspace is not initialized: $WORKSPACE" >&2
    exit 10
fi

BRANCH="$(
    sudo -u "$AGENT_USER" -H \
    git -C "$WORKSPACE" branch --show-current
)"

if [[ -z "$BRANCH" ]]; then
    echo "ERROR: Agent workspace is in detached HEAD state." >&2
    exit 11
fi

if [[ "$BRANCH" == "main" ]]; then
    CHAT_MODE="ask"
    MODE="protected-main"
else
    CHAT_MODE="code"
    MODE="development"
fi

echo "AI Forge — {{ agent_identity.name }}"
echo "Workspace: $WORKSPACE"
echo "Branch:    $BRANCH"
echo "Mode:      $MODE"
echo "Backend:   Aider"
echo

exec sudo -u "$AGENT_USER" -H \
    bash -lc 'cd "$1" && exec aider --chat-mode "$2"' \
    bash "$WORKSPACE" "$CHAT_MODE"
