[Unit]
Description=AI Forge llama.cpp inference server - {{ model.id }}
After=network.target
Wants=network.target

[Service]
Type=simple

User={{ inference.operational_user }}
Group={{ inference.operational_user }}

Environment=HOME={{ inference.operational_home }}
Environment=LLAMA_CACHE={{ inference.operational_home }}/.cache/huggingface/hub

ExecStartPre=/bin/bash -c 'for i in {1..60}; do /usr/bin/nvidia-smi >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'

ExecStart=/usr/local/bin/llama serve \
  -hf {{ model.hf_repo }}:{{ model.hf_quant }} \
  --offline \
  --alias {{ model.id }} \
  --ctx-size {{ inference.context_size }} \
{% if inference.dflash_enabled | default(false) %}
  --spec-draft-model {{ inference.dflash_model }} \
  --spec-type draft-dflash \
  --spec-draft-n-max {{ inference.dflash_n_max | default(15) }} \
{% endif %}
  --gpu-layers all \
  --parallel 1 \
  --host {{ inference.host }} \
  --port {{ inference.port }}

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
