#!/usr/bin/env python3
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument("--root", required=True)
parser.add_argument("--commit", required=True)
parser.add_argument("--configuration", required=True)
args = parser.parse_args()

root = Path(args.root).resolve()
runtime = root / "runtime"
source = root / "source"
build = root / "build"

def run(argv):
    return subprocess.check_output(
        argv, text=True, stderr=subprocess.STDOUT,
        env={k: v for k, v in os.environ.items() if k != "LD_LIBRARY_PATH"},
    ).strip()

def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()

def linked_libraries(path):
    output = run(["ldd", str(path)])
    libraries = []

    for line in output.splitlines():
        if "=>" not in line:
            continue

        name, target = line.split("=>", 1)
        target = target.strip().split()[0]

        if target == "not":
            raise SystemExit(
                f"Unresolved runtime library for {path}: {line}"
            )

        if target.startswith("/"):
            libraries.append((name.strip(), Path(target)))

    return output, libraries

server = runtime / "bin/llama-server"
if not server.is_file():
    raise SystemExit(f"Installed server missing: {server}")

commit = run(["git", "-C", str(source), "rev-parse", "HEAD"])
if commit != args.commit:
    raise SystemExit(f"Source commit mismatch: {commit}")

version = run([str(server), "--version"])
if args.commit[:9] not in version:
    raise SystemExit(f"Installed version mismatch: {version}")

linked, server_libraries = linked_libraries(server)

for name, target in server_libraries:
    if name.startswith(("libllama", "libggml", "libmtmd")):
        resolved = target.resolve()
        if not resolved.is_relative_to(runtime):
            raise SystemExit(
                f"Library outside installed runtime: "
                f"{name} => {target}"
            )

now = datetime.datetime.now(datetime.timezone.utc)
capture_time = now.isoformat()
artifacts = root / "artifacts"
artifacts.mkdir(mode=0o755, exist_ok=True)
capture = Path(tempfile.mkdtemp(
    prefix=now.strftime("%Y%m%dT%H%M%SZ-"), dir=artifacts
))
capture.chmod(0o755)
metadata = capture / "metadata"
metadata.mkdir()

# Record every installed file and symbolic link.
def inventory():
    entries = {}
    for path in sorted(runtime.rglob("*")):
        relative = path.relative_to(runtime).as_posix()
        if path.is_symlink():
            resolved = path.resolve(strict=True)
            if not resolved.is_relative_to(runtime):
                raise SystemExit(f"External runtime symbolic link: {path}")
            entries[relative] = {
                "type": "symlink",
                "target": os.readlink(path),
            }
        elif path.is_file():
            entries[relative] = {
                "type": "file",
                "size": path.stat().st_size,
                "mode": oct(path.stat().st_mode & 0o7777),
                "sha256": sha256(path),
            }
        elif not path.is_dir():
            raise SystemExit(f"Unsupported installed entry: {path}")
    return entries

before = inventory()
(metadata / "runtime-files.json").write_text(
    json.dumps(before, indent=2) + "\n"
)
(metadata / "version.txt").write_text(version + "\n")
(metadata / "linked-libraries.txt").write_text(linked + "\n")

# Record the actual compilers selected by CMake, including versioned CUDA paths.
def cmake_setting(name):
    values = []
    for line in (build / "CMakeCache.txt").read_text().splitlines():
        if line.startswith(name + ":") and "=" in line:
            values.append(line.split("=", 1)[1])
    if len(values) != 1 or not values[0]:
        raise SystemExit("Missing or ambiguous CMake setting: " + name)
    return values[0]

actual_compilers = {
    "gcc-version.txt": cmake_setting("CMAKE_C_COMPILER"),
    "gxx-version.txt": cmake_setting("CMAKE_CXX_COMPILER"),
    "cuda-version.txt": cmake_setting("CMAKE_CUDA_COMPILER"),
}
for compiler in actual_compilers.values():
    if not Path(compiler).is_absolute() or not os.access(compiler, os.X_OK):
        raise SystemExit("Captured compiler is not executable: " + compiler)
(metadata / "compiler-paths.json").write_text(
    json.dumps(actual_compilers, indent=2) + "\n"
)

# An sm120 capture must contain compiled CUDA code for that architecture.
# This checks artifact contents; successful model execution is a separate test.
if "120" in cmake_setting("CMAKE_CUDA_ARCHITECTURES").split(";"):
    cuobjdump = Path(actual_compilers["cuda-version.txt"]).parent / "cuobjdump"
    backends = sorted({p.resolve() for p in runtime.rglob("libggml-cuda.so*") if p.is_file()})
    if not cuobjdump.is_file() or not backends:
        raise SystemExit("Cannot inspect sm120 CUDA backend")
    code_evidence = []
    for backend in backends:
        listing = run([str(cuobjdump), "--list-elf", str(backend)])
        if "sm_120" not in listing:
            raise SystemExit("CUDA backend lacks sm120 native code: " + str(backend))
        code_evidence.append(str(backend) + "\n" + listing)
    (metadata / "cuda-code.txt").write_text("\n".join(code_evidence) + "\n")

# Create the deployable runtime without modifying the installed build.
staged_runtime = capture / "runtime"
shutil.copytree(runtime, staged_runtime, symlinks=True)

bundled_cuda_libraries = []

cuda_backends = sorted({
    path.resolve()
    for path in runtime.rglob("libggml-cuda.so*")
    if path.is_file()
})

for backend in cuda_backends:
    backend_linked, backend_libraries = linked_libraries(backend)

    for soname, target in backend_libraries:
        resolved = target.resolve()

        try:
            resolved.relative_to("/opt/cuda")
        except ValueError:
            continue

        destination = staged_runtime / "lib" / resolved.name

        if not destination.exists():
            shutil.copy2(resolved, destination)

        soname_path = staged_runtime / "lib" / soname

        if soname_path != destination:
            if soname_path.exists() or soname_path.is_symlink():
                soname_path.unlink()
            soname_path.symlink_to(destination.name)

        record = {
            "soname": soname,
            "source": str(resolved),
            "filename": resolved.name,
            "sha256": sha256(resolved),
        }

        if record not in bundled_cuda_libraries:
            bundled_cuda_libraries.append(record)

# Validate the deployable copy. CUDA toolkit libraries must now resolve
# from the staged runtime; libcuda remains supplied by the NVIDIA driver.
staged_server = staged_runtime / "bin/llama-server"
staged_backend = staged_runtime / "lib/libggml-cuda.so"

staged_server_linked, _ = linked_libraries(staged_server)

staged_backend_linked = ""
if staged_backend.exists():
    staged_backend_linked, _ = linked_libraries(staged_backend)

staged_linked = (
    "=== llama-server ===\n"
    + staged_server_linked
    + "\n\n=== libggml-cuda.so ===\n"
    + staged_backend_linked
)

if "/opt/cuda" in staged_linked:
    raise SystemExit(
        "Staged runtime still resolves libraries from /opt/cuda"
    )

(metadata / "linked-libraries-staged.txt").write_text(
    staged_linked + "\n"
)

if shutil.which("dpkg-query"):
    package_manager = "dpkg"
    package_inventory_command = [
        "dpkg-query", "-W",
        "-f=${binary:Package}\\t${Version}\\t${Architecture}\\t${db:Status-Status}\\n",
    ]
elif shutil.which("pacman"):
    package_manager = "pacman"
    package_inventory_command = ["pacman", "-Q"]
else:
    raise SystemExit("No supported package manager found for package evidence")

evidence_commands = {
    "os-release.txt": ["cat", "/etc/os-release"],
    "kernel.txt": ["uname", "-a"],
    "cpu.txt": ["lscpu"],
    "gpu.txt": [
        "nvidia-smi",
        "--query-gpu=name,compute_cap,driver_version",
        "--format=csv,noheader",
    ],
    "installed-packages.tsv": package_inventory_command,
    "cmake-version.txt": ["cmake", "--version"],
    "gcc-version.txt": [actual_compilers["gcc-version.txt"], "--version"],
    "gxx-version.txt": [actual_compilers["gxx-version.txt"], "--version"],
    "cuda-version.txt": [actual_compilers["cuda-version.txt"], "--version"],
}
for filename, command in evidence_commands.items():
    (metadata / filename).write_text(run(command) + "\n")

for path in [
    build / "CMakeCache.txt",
    build / "install_manifest.txt",
    Path("/usr/local/sbin/ai-forge-build-llama"),
]:
    if not path.is_file():
        raise SystemExit(f"Build evidence missing: {path}")
    shutil.copy2(path, metadata / path.name)

compiler_metadata = metadata / "cmake-compilers"
compiler_metadata.mkdir()
for path in (build / "CMakeFiles").glob("*/CMake*Compiler.cmake"):
    shutil.copy2(path, compiler_metadata / f"{path.parent.name}-{path.name}")

shutil.copy2(source / "LICENSE", metadata / "llama.cpp-LICENSE")

provenance = {
    "schema_version": 1,
    "capture_id": capture.name,
    "captured_at_utc": capture_time,
    "configuration_id": args.configuration,
    "source_commit": commit,
    "source_upstream": "https://github.com/ggml-org/llama.cpp.git",
    "source_commit_details": run([
        "git", "-C", str(source), "show", "-s",
        "--format=%H%n%cI%n%s", "HEAD",
    ]),
    "installed_version": version,
    "original_install_prefix": str(runtime),
    "ui_archive_sha256": sha256(root / "ui-dist.tar.gz"),
    "validation": {
        "installed_version": "passed",
        "server_library_resolution": "passed",
        "muse_vision_and_hermes": "pending",
        "clean_buildless_deployment": "pending",
    },
    "bundled_runtime_dependencies": {
        "cuda": bundled_cuda_libraries,
    },
    "package_evidence": {
        "manager": package_manager,
        "file": "installed-packages.tsv",
        "description": (
            "Full installed-package inventory; "
            "not a runtime dependency closure."
        ),
    },
}
(metadata / "provenance.json").write_text(
    json.dumps(provenance, indent=2) + "\n"
)

archive = capture / "llama-runtime.tar.gz"
with tarfile.open(archive, "w:gz", dereference=False) as tar:
    tar.add(staged_runtime, arcname="runtime")
    tar.add(metadata, arcname="metadata")

if inventory() != before:
    archive.unlink()
    raise SystemExit("Runtime changed during capture; rerun after the build finishes")

checksum = sha256(archive)
archive.chmod(0o644)
(capture / "llama-runtime.tar.gz.sha256").write_text(
    f"{checksum}  {archive.name}\n"
)
print(json.dumps({
    "capture_id": capture.name,
    "archive": str(archive),
    "sha256": checksum,
    "provenance": provenance,
}))
