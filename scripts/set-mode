#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <machine> <normal|provision|capture|restore>" >&2
    exit 2
fi

MACHINE="$1"
MODE="$2"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

[[ "$MACHINE" =~ ^[a-zA-Z0-9_-]+$ ]] || {
    echo "Invalid machine name." >&2
    exit 2
}

test -f "$ROOT/machines/$MACHINE/machine.yaml" || {
    echo "Unknown machine: $MACHINE" >&2
    exit 2
}

case "$MODE" in
    normal|provision) ;;
    capture|restore)
        test "$MACHINE" = daedalus-02 || {
            echo "Imaging currently supports daedalus-02 only." >&2
            exit 2
        }
        test -s "$ROOT/runtime/http/$MACHINE/$MODE.ipxe" || {
            echo "Missing $MODE boot file; mode unchanged." >&2
            exit 2
        }
        ;;
    *)
        echo "Invalid mode: $MODE" >&2
        exit 2
        ;;
esac

STATE_DIR="$ROOT/runtime/state/$MACHINE"
mkdir -p "$STATE_DIR"
temporary="$(mktemp "$STATE_DIR/.mode.XXXXXXXX")"
trap 'rm -f "$temporary"' EXIT
printf '%s\n' "$MODE" > "$temporary"
mv "$temporary" "$STATE_DIR/mode"

if [ "$MODE" = normal ]; then
    echo "$MACHINE: mode set to normal"
else
    echo "$MACHINE: armed for ONE $MODE boot"
fi
