#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <machine> <normal|provision>"
    exit 1
fi

MACHINE="$1"
MODE="$2"

case "$MODE" in
    normal|provision)
        ;;
    *)
        echo "Invalid mode: $MODE"
        echo "Valid modes: normal, provision"
        exit 1
        ;;
esac

STATE_DIR="${HOME}/graystone/provisioning-data/state/${MACHINE}"

mkdir -p "$STATE_DIR"

printf '%s\n' "$MODE" > "${STATE_DIR}/mode"

if [ "$MODE" = "provision" ]; then
    echo "${MACHINE}: armed for ONE provisioning boot"
else
    echo "${MACHINE}: mode set to normal"
fi
