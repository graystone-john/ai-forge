#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <machine>"
    exit 2
fi

MACHINE="$1"
MACHINE_FILE="$ROOT/machines/$MACHINE/machine.yaml"

if [[ ! -f "$MACHINE_FILE" ]]; then
    echo "ERROR: Unknown machine: $MACHINE" >&2
    exit 3
fi

readarray -t INFO < <(
    python3 - "$MACHINE_FILE" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as f:
    machine = yaml.safe_load(f)

network = machine.get("network", {})

print(network.get("provisioning_ip", ""))
print(network.get("provisioning_mac", ""))
PY
)

IP="${INFO[0]}"
MAC="${INFO[1]}"
if [[ -z "$IP" || -z "$MAC" ]]; then
    echo "ERROR: $MACHINE requires provisioning_ip and provisioning_mac" >&2
    exit 3
fi

echo "Machine: $MACHINE"
echo "IP:      $IP"
echo "MAC:     $MAC"
echo

#
# Don't send WOL if the machine is already SSH-ready. Reuse check-machine
# so readiness and SSH host trust follow the same policy as `forge status`.
#
if "$ROOT/scripts/check-machine" "$MACHINE" >/dev/null 2>&1; then
    echo "$MACHINE is already SSH-ready."
    exit 0
else
    CHECK_RC=$?
    if [[ $CHECK_RC -eq 13 ]]; then
        "$ROOT/scripts/check-machine" "$MACHINE" || true
        exit 13
    fi
fi

echo "Sending Wake-on-LAN..."

wakeonlan \
    -i 10.10.10.255 \
    -p 9 \
    "$MAC"

echo
echo "Waiting for SSH..."

#
# 60 attempts x 2 seconds = approximately 2 minutes.
#
for attempt in $(seq 1 60); do

    if "$ROOT/scripts/check-machine" "$MACHINE" >/dev/null 2>&1; then
        echo
        echo
        echo "$MACHINE is SSH-ready."
        echo

        "$ROOT/scripts/check-machine" "$MACHINE"
        exit 0
    else
        CHECK_RC=$?
        if [[ $CHECK_RC -eq 13 ]]; then
            echo
            echo
            "$ROOT/scripts/check-machine" "$MACHINE" || true
            exit 13
        fi
    fi

    printf '.'
    sleep 2
done

echo
echo
echo "ERROR: $MACHINE did not become SSH-ready within 120 seconds." >&2

echo
"$ROOT/scripts/check-machine" "$MACHINE" || true

exit 20
