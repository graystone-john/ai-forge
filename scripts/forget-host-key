#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <machine>"
    exit 2
fi

MACHINE="$1"
MACHINE_FILE="$ROOT/machines/$MACHINE/machine.yaml"

if [[ ! -f "$MACHINE_FILE" ]]; then
    echo "ERROR: Unknown machine: $MACHINE" >&2
    exit 3
fi

readarray -t INFO < <(
    python3 - "$MACHINE_FILE" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as f:
    machine = yaml.safe_load(f)

network = machine.get("network", {})

print(network.get("provisioning_ip", ""))
print(machine.get("name", ""))
PY
)

IP="${INFO[0]}"
HOSTNAME="${INFO[1]}"

if [[ -z "$IP" ]]; then
    echo "ERROR: No provisioning_ip configured for $MACHINE" >&2
    exit 3
fi

echo "Machine:  $MACHINE"
echo "IP:       $IP"
echo "Hostname: ${HOSTNAME:-unknown}"

remove_host_key() {
    local target="$1"

    [[ -n "$target" ]] || return 0

    if ssh-keygen -F "$target" >/dev/null 2>&1; then
        echo "Removing previous SSH host key for $target..."
        ssh-keygen -R "$target"
    else
        echo "No previous SSH host key recorded for $target."
    fi
}

remove_host_key "$IP"
remove_host_key "$HOSTNAME"
