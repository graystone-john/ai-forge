#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <machine>" >&2
    exit 2
fi

MACHINE="$1"
MACHINE_FILE="$ROOT/machines/$MACHINE/machine.yaml"

if [[ ! -f "$MACHINE_FILE" ]]; then
    echo "ERROR: Unknown machine: $MACHINE" >&2
    exit 3
fi

echo "Machine: $MACHINE"
echo

echo "Generating configuration..."
"$ROOT/scripts/generate.py" "$MACHINE"

IS_ARCH="$(
    python3 - "$MACHINE_FILE" <<'PYARCH'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as f:
    machine = yaml.safe_load(f)

os_config = machine.get("os")

if not isinstance(os_config, dict):
    raise SystemExit("Machine has no OS configuration")

distribution = os_config.get("distribution")
version = os_config.get("version")

if not distribution or not version:
    raise SystemExit(
        "Machine requires os.distribution and os.version"
    )

print("yes" if distribution == "arch" else "no")
PYARCH
)"

if [[ "$IS_ARCH" == "yes" ]]; then
    "$ROOT/scripts/generate-arch-install.py" "$MACHINE"
fi

echo
echo "Validating configuration..."
"$ROOT/scripts/validate-machine.py" "$MACHINE"

echo
echo "Deploying configuration..."
# Deploy the generated files that just passed validation.
python3 - "$ROOT" "$MACHINE" <<'PY'
from pathlib import Path
import shutil
import sys
import yaml

root = Path(sys.argv[1])
machine_name = sys.argv[2]

machine = yaml.safe_load(
    (root / "machines" / machine_name / "machine.yaml").read_text(
        encoding="utf-8"
    )
)
distribution = machine["os"]["distribution"]

generated = root / "generated" / machine_name
http_root = root / "runtime" / "http"
machine_http = http_root / machine_name

files = [
    (generated / "boot.ipxe", http_root / "boot.ipxe"),
    (generated / "normal.ipxe", machine_http / "normal.ipxe"),
    (generated / "provision.ipxe", machine_http / "provision.ipxe"),
]

if distribution == "ubuntu":
    files.extend(
        (generated / name, machine_http / name)
        for name in ("user-data", "meta-data", "vendor-data")
    )
elif distribution != "arch":
    raise SystemExit(f"Unsupported OS distribution: {distribution!r}")

for source, destination in files:
    if not source.is_file():
        raise SystemExit(f"Missing generated file: {source}")

machine_http.mkdir(parents=True, exist_ok=True)

for source, destination in files:
    shutil.copy2(source, destination)
    print(f"Deployed {destination}")
PY

if [[ "$IS_ARCH" == "yes" ]]; then
    ARCH_GENERATED="$ROOT/generated/$MACHINE/arch"
    ARCH_HTTP="$ROOT/runtime/http/$MACHINE/arch"

    mkdir -p "$ARCH_HTTP"

    cp         "$ARCH_GENERATED/install.yaml"         "$ARCH_HTTP/install.yaml"

    cp         "$ROOT/scripts/installers/install-arch"         "$ARCH_HTTP/install-arch"

    cp         "$ROOT/scripts/disk_resolver.py"         "$ARCH_HTTP/disk_resolver.py"

    chmod 0755 "$ARCH_HTTP/install-arch"
    chmod 0644         "$ARCH_HTTP/install.yaml"         "$ARCH_HTTP/disk_resolver.py"

    echo "  $ARCH_HTTP/install.yaml"
    echo "  $ARCH_HTTP/install-arch"
    echo "  $ARCH_HTTP/disk_resolver.py"
fi

echo
echo "Deployment complete: $MACHINE"
