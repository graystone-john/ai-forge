#!/usr/bin/env python3
"""Coordinate telemetry and bounded inference or Hermes workloads."""
import argparse
import datetime
import json
from pathlib import Path
import queue
import signal
import subprocess
import threading
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent

def positive(value):
    n = int(value)
    if n <= 0:
        raise argparse.ArgumentTypeError("Must be positive")
    return n

def reader(stream, messages, name):
    for line in stream:
        messages.put((name, line))
    messages.put((name, None))

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("machine")
    parser.add_argument("--tokens", type=positive, default=8192)
    parser.add_argument("--predict", type=positive, default=512)
    parser.add_argument("--shelly", help="Shelly local IPv4 address")
    parser.add_argument("--repeat", type=positive, default=1,
                        help="Sequential requests in one continuous capture")
    parser.add_argument("--workload", choices=("inference", "hermes"),
                        default="inference")
    args = parser.parse_args()
    if args.workload == "hermes" and args.machine != "daedalus-01":
        parser.error("Hermes v1 supports daedalus-01 only")
    if args.shelly:
        import ipaddress
        args.shelly = str(ipaddress.IPv4Address(args.shelly))
    if not __import__("re").fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9_.-]*", args.machine
    ):
        parser.error("Invalid machine name")

    for script in ("performance-machine", "performance-" + args.workload):
        if not (ROOT / "scripts" / script).is_file():
            parser.error(f"Missing scripts/{script}")

    vault = ROOT.parent / "ai-stores/vault"
    if not vault.is_dir():
        parser.error("Existing AI Stores vault not found")

    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run_id = f"{stamp}-paired-{uuid.uuid4().hex[:8]}"
    out = vault / "graystone/performance/v1/sessions" / args.machine / run_id
    out.mkdir(parents=True, exist_ok=False)

    manifest = {
        "run_id": run_id,
        "machine": args.machine,
        "shelly_address": args.shelly,
        "workload_kind": args.workload,
        "input_tokens": args.tokens if args.workload == "inference" else None,
        "output_tokens": args.predict if args.workload == "inference" else None,
        "repeat": args.repeat,
        "workloads": [],
        "telemetry_limit_seconds": 720 * args.repeat + 180,
        "warmup_idle_seconds": 10,
        "recovery_seconds": 30,
        "status": "starting",
    }
    manifest_path = out / "session.json"

    def save():
        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")

    save()
    (out / "wall-meter.csv").write_text(
        "phase,watts,amps,notes\n"
    )
    print(f"SESSION: {out}", flush=True)
    print("Keep other Hermes/inference requests idle during this test.", flush=True)

    messages = queue.Queue()
    processes = {}
    closed = set()

    def launch(name, argv):
        process = subprocess.Popen(
            argv, cwd=ROOT,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, start_new_session=True,
        )
        processes[name] = process
        threading.Thread(
            target=reader, args=(process.stdout, messages, name),
            daemon=True,
        ).start()
        return process

    def consume(log, timeout=0.2):
        try:
            name, line = messages.get(timeout=timeout)
        except queue.Empty:
            return None
        if line is None:
            closed.add(name)
            return None
        log.write(f"[{name}] {line}")
        log.flush()
        print(f"[{name}] {line}", end="", flush=True)

        if name == "telemetry" and line.startswith("Results: "):
            manifest["telemetry_directory"] = line.split(": ", 1)[1].strip()
            save()
        if name == "workload" and line.startswith("Workload evidence: "):
            manifest["workload_directory"] = line.split(": ", 1)[1].strip()
            manifest["workloads"][-1]["directory"] = manifest["workload_directory"]
            manifest["workloads"][-1]["status"] = "running"
            save()
        return name, line

    def stop(process):
        if process.poll() is not None:
            return
        # Interrupt only the controller first, allowing it to save its summary.
        process.send_signal(signal.SIGINT)
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            import os
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()

    try:
        with (out / "console.log").open("w") as log:
            telemetry = launch("telemetry", [
                str(ROOT / "scripts/performance-machine"), args.machine,
                *(["--shelly", args.shelly] if args.shelly else []),
                "--stage", "hermes" if args.workload == "hermes" else "heavy-inference",
                "--seconds", str(manifest["telemetry_limit_seconds"]),
                "--notes",
                f"Paired session {run_id}; workload={args.workload}; repeat={args.repeat}",
            ])

            deadline = time.monotonic() + 60
            ready = False
            while time.monotonic() < deadline:
                item = consume(log)
                if item and item[0] == "telemetry" and "CAPTURE START:" in item[1]:
                    ready = True
                    break
                if telemetry.poll() is not None:
                    break
            if not ready:
                raise RuntimeError("Telemetry did not confirm capture start")

            # Require actual saved samples before launching the workload.
            capture = Path(manifest["telemetry_directory"])
            deadline = time.monotonic() + 20
            while time.monotonic() < deadline:
                consume(log)
                if telemetry.poll() is not None:
                    raise RuntimeError("Telemetry exited before workload")
                raw = capture / "telemetry.jsonl"
                if raw.exists():
                    events = [
                        json.loads(line)
                        for line in raw.read_text().splitlines(keepends=True)
                        if line.endswith("\n") and line.strip()
                    ]
                    if any(e.get("type") == "sample" for e in events):
                        break
            else:
                raise RuntimeError("No telemetry samples saved")

            print("\nBASELINE: recording 10 seconds before workload.", flush=True)
            deadline = time.monotonic() + 10
            while time.monotonic() < deadline:
                consume(log)
                if telemetry.poll() is not None:
                    raise RuntimeError("Telemetry stopped during baseline")

            manifest["status"] = "running"
            save()
            for request_number in range(1, args.repeat + 1):
                print(
                    f"\nWORKLOAD: request {request_number} of {args.repeat}",
                    flush=True,
                )
                closed.discard("workload")
                manifest.pop("workload_directory", None)
                entry = {
                    "request_number": request_number,
                    "status": "starting",
                }
                manifest["workloads"].append(entry)
                save()
                workload_argv = [
                    str(ROOT / ("scripts/performance-" + args.workload)),
                    args.machine,
                ]
                if args.workload == "hermes":
                    workload_argv += ["--non-interactive"]
                else:
                    workload_argv += [
                        "--tokens", str(args.tokens),
                        "--predict", str(args.predict),
                    ]
                workload = launch("workload", workload_argv)

                deadline = time.monotonic() + 720
                while workload.poll() is None or "workload" not in closed:
                    consume(log)
                    if telemetry.poll() is not None:
                        raise RuntimeError("Telemetry stopped during workload")
                    if time.monotonic() > deadline:
                        raise RuntimeError("Workload exceeded controller timeout")

                manifest["workload_exit_code"] = workload.returncode
                save()
                entry["exit_code"] = workload.returncode
                entry["status"] = (
                    "completed" if workload.returncode == 0 else "failed"
                )
                save()
                if workload.returncode != 0:
                    break

            print("\nRECOVERY: recording 30 seconds after workload.", flush=True)
            deadline = time.monotonic() + 30
            while time.monotonic() < deadline:
                consume(log)
                if telemetry.poll() is not None:
                    raise RuntimeError("Telemetry stopped during recovery")

            stop(telemetry)
            deadline = time.monotonic() + 5
            while "telemetry" not in closed and time.monotonic() < deadline:
                consume(log)

            summary = json.loads((capture / "summary.json").read_text())
            manifest["telemetry_samples"] = summary["samples"]
            manifest["telemetry_status"] = summary["status"]
            if args.shelly:
                meter = summary.get("shelly") or {}
                manifest["shelly"] = meter
                manifest["measurement_status"] = meter.get("status", "failed")
                if (
                    meter.get("status") not in ("completed", "degraded")
                    or meter.get("valid_samples", 0) < 2
                    or meter.get("worker_error")
                ):
                    raise RuntimeError("Shelly recorder failed or insufficient readings")
            if summary["samples"] <= 0 or summary["status"] == "failed":
                raise RuntimeError("Telemetry did not preserve a valid capture")
            manifest["workload_status"] = (
                "completed" if workload.returncode == 0 else "failed"
            )
            manifest["status"] = (
                "workload_failed" if workload.returncode != 0 else
                "completed_with_gaps"
                if manifest.get("measurement_status") == "degraded" else
                "completed"
            )
            if manifest["status"] == "completed_with_gaps":
                print(
                    "WARNING: Workloads completed; Shelly readings have gaps. "
                    "Review error counts and timestamps before interpreting power.",
                    flush=True,
                )
    except KeyboardInterrupt:
        manifest["status"] = "interrupted"
    except Exception as exc:
        manifest["status"] = "failed"
        manifest["error"] = str(exc)
        print(f"ERROR: {exc}", flush=True)
    finally:
        for process in reversed(list(processes.values())):
            stop(process)
        save()

    print("\nSESSION RESULT")
    print(json.dumps(manifest, indent=2))
    print(f"Session evidence: {out}")
    return 0 if manifest["status"] == "completed" else 1

if __name__ == "__main__":
    raise SystemExit(main())
