#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <machine>"
    exit 2
fi

MACHINE="$1"
MACHINE_FILE="$ROOT/machines/$MACHINE/machine.yaml"

ARMED=0
BOOTNEXT_SET=0

cleanup() {
    rc=$?

    trap - ERR INT TERM EXIT

    if [[ "$ARMED" -eq 1 ]]; then
        echo
        echo "Provisioning did not complete cleanly."
        echo "Resetting $MACHINE to NORMAL..."

        "$ROOT/scripts/set-mode" "$MACHINE" normal || true
    fi

    if [[ "$BOOTNEXT_SET" -eq 1 ]]; then
        echo
        echo "Clearing one-time PXE BootNext..."

        "$ROOT/scripts/boot-machine" "$MACHINE" clear-next || true
    fi

    exit "$rc"
}

trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup EXIT

if [[ ! -f "$MACHINE_FILE" ]]; then
    echo "ERROR: Unknown machine: $MACHINE" >&2
    exit 3
fi

readarray -t INFO < <(
    python3 - "$MACHINE_FILE" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as f:
    machine = yaml.safe_load(f)

network = machine.get("network", {})
print(network.get("provisioning_ip", ""))
print(network.get("provisioning_mac", ""))
PY
)

IP="${INFO[0]}"
MAC="${INFO[1]}"

if [[ -z "$IP" || -z "$MAC" ]]; then
    echo "ERROR: Missing provisioning_ip or provisioning_mac for $MACHINE" >&2
    exit 3
fi

echo "Machine: $MACHINE"
echo "IP:      $IP"
echo "MAC:     $MAC"
echo

echo "Checking machine readiness..."

if ! "$ROOT/scripts/check-machine" "$MACHINE"; then
    echo
    echo "ERROR: $MACHINE is not SSH-ready." >&2
    echo "Run:"
    echo "  ./scripts/wake-machine $MACHINE"
    exit 10
fi

echo
echo "Preparing provisioning configuration..."

"$ROOT/scripts/deploy-machine" "$MACHINE"

echo
echo "Provisioning plan:"
echo "  Machine:  $MACHINE"
echo "  IP:       $IP"
echo "  MAC:      $MAC"
echo "  Action:   WIPE AND REINSTALL configured OS disk"
echo

echo "Setting one-time PXE boot..."

"$ROOT/scripts/boot-machine" "$MACHINE" pxe-next
BOOTNEXT_SET=1

echo
echo "Arming one-shot provisioning..."

"$ROOT/scripts/set-mode" "$MACHINE" provision
ARMED=1

echo
echo "Rebooting $MACHINE into PXE..."

"$ROOT/scripts/boot-machine" "$MACHINE" reboot
BOOTNEXT_SET=0

echo
echo "Removing old SSH host key after reboot request..."

"$ROOT/scripts/forget-host-key" "$MACHINE"

ARMED=0

echo
echo "Provision request sent."
echo "The controller should consume PROVISION and return mode to NORMAL."
echo
echo "Wait for the rebuilt AI Node with:"
echo "  ./forge wait $MACHINE --for ssh --timeout 1200"

