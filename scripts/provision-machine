#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $0 <machine> [--first-install]" >&2
    exit 2
fi

FIRST_INSTALL=0
if [[ $# -eq 2 ]]; then
    if [[ "$2" != "--first-install" ]]; then
        echo "ERROR: Unknown option: $2" >&2
        exit 2
    fi
    FIRST_INSTALL=1
fi

MACHINE="$1"
if [[ ! "$MACHINE" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
    echo "ERROR: Invalid machine name." >&2
    exit 2
fi
MACHINE_FILE="$ROOT/machines/$MACHINE/machine.yaml"

ARMED=0
BOOTNEXT_SET=0

cleanup() {
    rc=$?

    trap - ERR INT TERM EXIT

    if [[ "$ARMED" -eq 1 ]]; then
        echo
        echo "Provisioning did not complete cleanly."
        echo "Resetting $MACHINE to NORMAL..."

        "$ROOT/scripts/set-mode" "$MACHINE" normal || true
    fi

    if [[ "$BOOTNEXT_SET" -eq 1 ]]; then
        echo
        echo "Clearing one-time PXE BootNext..."

        "$ROOT/scripts/boot-machine" "$MACHINE" clear-next || true
    fi

    exit "$rc"
}

trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup EXIT

if [[ ! -f "$MACHINE_FILE" ]]; then
    echo "ERROR: Unknown machine: $MACHINE" >&2
    exit 3
fi

readarray -t INFO < <(
    python3 - "$MACHINE_FILE" <<'PY'
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as f:
    machine = yaml.safe_load(f)

network = machine.get("network", {})
print(network.get("provisioning_ip", ""))
print(network.get("provisioning_mac", ""))
PY
)

IP="${INFO[0]}"
MAC="${INFO[1]}"

if [[ -z "$IP" || -z "$MAC" ]]; then
    echo "ERROR: Missing provisioning_ip or provisioning_mac for $MACHINE" >&2
    exit 3
fi

echo "Machine: $MACHINE"
echo "IP:      $IP"
echo "MAC:     $MAC"
echo

if [[ "$FIRST_INSTALL" -eq 1 ]]; then
    echo "First installation: target will be booted manually through UEFI PXE."
else
    echo "Checking machine readiness..."

    if ! "$ROOT/scripts/check-machine" "$MACHINE"; then
        echo
        echo "ERROR: $MACHINE is not SSH-ready." >&2
        echo "Run:"
        echo "  ./scripts/wake-machine $MACHINE"
        exit 10
    fi
fi

echo
echo "Preparing provisioning configuration..."

if [[ "$MACHINE" == "daedalus-02" ]]; then
    python3 "$ROOT/scripts/host_identity.py" check "$MACHINE"
    if [[ "$FIRST_INSTALL" -eq 0 ]]; then
        python3 "$ROOT/scripts/host_identity.py" stage "$MACHINE"
    fi
    # Persistent identity must never be replaced by a newly presented key.
    rm -f "$ROOT/runtime/state/$MACHINE/ssh-key-refresh"
fi

"$ROOT/scripts/deploy-machine" "$MACHINE"

if [[ "$FIRST_INSTALL" -eq 1 ]]; then
    echo
    echo "Generating and deploying DHCP reservations..."
    "$ROOT/scripts/generate-dnsmasq.py"
    "$ROOT/scripts/deploy-dnsmasq"
fi

echo
echo "Provisioning plan:"
echo "  Machine:  $MACHINE"
echo "  IP:       $IP"
echo "  MAC:      $MAC"
echo "  Action:   WIPE AND REINSTALL configured OS disk"
echo

if [[ "$FIRST_INSTALL" -eq 1 ]]; then
    echo "Arming one-shot provisioning..."
    ARMED=1
    "$ROOT/scripts/set-mode" "$MACHINE" provision

    echo
    echo "Ready for manual UEFI IPv4 PXE boot."
    echo "Start $MACHINE on the provisioning Ethernet network."
    echo "The next authorized provisioning boot will WIPE AND REINSTALL its configured OS disk."
    echo
    echo "To cancel before that boot:"
    echo "  ./scripts/set-mode $MACHINE normal"
    echo
    echo "After starting PXE, wait for the installed system:"
    echo "  ./forge wait $MACHINE --for ssh --timeout 1200"

    # Intentionally retain the armed state after this successful handoff.
    ARMED=0
    exit 0
fi

# Finish Hermes before arming a destructive provisioning boot.
# First-install mode exits above; a failed handshake aborts here.
if [[ "$MACHINE" == "daedalus-02" ]]; then
    SSH_KEY="$ROOT/secrets/ssh/id_ed25519_ai_forge"
    SSH_USER="$(python3 -c 'import sys,yaml; print(yaml.safe_load(open(sys.argv[1])).get("defaults", {}).get("username", ""))' "$ROOT/config/forge.yaml")"
    [[ -n "$SSH_USER" ]] || { echo "ERROR: Missing SSH username." >&2; exit 3; }
    [[ -f "$SSH_KEY" ]] || { echo "ERROR: Missing AI Forge SSH key." >&2; exit 4; }

    echo "Waiting for Hermes to finish and exit..."
    ssh -T \
        -i "$SSH_KEY" \
        -o BatchMode=yes \
        -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=yes \
        -o ConnectTimeout=5 \
        -o ServerAliveInterval=5 \
        -o ServerAliveCountMax=2 \
        "$SSH_USER@$IP" \
        'sudo -n python3 -' < "$ROOT/scripts/imaging/close-hermes.py"
fi

echo "Setting one-time PXE boot..."

"$ROOT/scripts/boot-machine" "$MACHINE" pxe-next
BOOTNEXT_SET=1

echo
echo "Arming one-shot provisioning..."

ARMED=1
"$ROOT/scripts/set-mode" "$MACHINE" provision

MODE_FILE="$ROOT/runtime/state/$MACHINE/mode"
MODE="$(cat "$MODE_FILE")"

if [[ "$MODE" != "provision" ]]; then
    echo "ERROR: Failed to verify PROVISION state for $MACHINE" >&2
    exit 20
fi

echo "Provisioning state verified: $MODE"

STATE_DIR="$ROOT/runtime/state/$MACHINE"
SSH_REFRESH_MARKER="$STATE_DIR/ssh-key-refresh"

#
# Machines without persistent identity generate a new SSH host key.
# Record that expectation so wait-machine can safely handle exactly one
# host-key transition after provisioning.
#
if [[ "$MACHINE" == "daedalus-02" ]]; then
    rm -f "$SSH_REFRESH_MARKER"
    echo "Persistent SSH host identity: existing trust retained."
else
    touch "$SSH_REFRESH_MARKER"
    echo "SSH host-key refresh armed."
fi

echo
echo "Rebooting $MACHINE into PXE..."

"$ROOT/scripts/boot-machine" "$MACHINE" reboot
BOOTNEXT_SET=0

echo
echo "Controller state immediately after reboot request:"
cat "$MODE_FILE"

ARMED=0

echo
echo "Provision request sent."
echo "The controller should consume PROVISION and return mode to NORMAL."
echo
echo "Wait for the rebuilt AI Node with:"
echo "  ./forge wait $MACHINE --for ssh --timeout 1200"

